DB_HOST=localhost
DB_PORT=5432
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_NAME=optiroute_db
DB_USER=postgres
DB_PASSWORD=cambiar_contrasena

# --- Fase 3: seguridad y autenticacion -------------------------------
# Backend de almacenamiento de cuentas y sesiones:
#   local    -> archivos JSON provisionales (desarrollo y pruebas)
#   postgres -> tablas seguridad.cuentas_acceso / sesiones_acceso /
#               auditoria_acceso (recomendado en produccion)
# Antes de usar postgres debe aplicarse database/scripts/006_seguridad_acceso.sql
OPTIROUTE_AUTH_STORAGE=local

# Duracion de las sesiones en horas (por defecto 8).
AUTH_SESSION_HORAS=8

# Iteraciones PBKDF2 para nuevas contrasenas (los hashes ya guardados
# conservan sus propias iteraciones y siguen siendo verificables).
AUTH_PBKDF2_ITERACIONES=210000

# Modo estricto de sesion: si la sesion cambia de navegador (User-Agent) o de
# red se revoca automaticamente. Desactivado por defecto para no expulsar a
# usuarios con redes moviles o proxies.
AUTH_SESION_ESTRICTA=0

# Degradar al almacenamiento local si PostgreSQL no responde.
# Mantener desactivado salvo en desarrollo: podria divergir los datos.
OPTIROUTE_AUTH_FALLBACK_LOCAL=0

# Directorio de datos provisional (solo con OPTIROUTE_AUTH_STORAGE=local).
# Por defecto: backend/data/seguridad
# OPTIROUTE_AUTH_DATA_DIR=C:\ruta\segura\seguridad

# Ejecutar las pruebas de integracion contra PostgreSQL real
# (crean y revierten sus propias tablas en una transaccion).
# OPTIROUTE_TEST_DB=0
